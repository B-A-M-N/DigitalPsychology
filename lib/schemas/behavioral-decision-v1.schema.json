{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digitalpsychology.dev/schemas/behavioral-decision-v1.schema.json",
  "title": "DigitalPsychology BehavioralDecision v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["decision_id", "scope", "expected_revision", "state", "directives", "preferred_stateworks", "intervention_outcomes", "reason"],
  "properties": {
    "decision_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "scope": {"type": "string", "minLength": 1, "maxLength": 256},
    "expected_revision": {"type": "integer", "minimum": 0},
    "state": {"$ref": "behavior-state-v1.schema.json"},
    "directives": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/directive"}},
    "preferred_stateworks": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
    "intervention_outcomes": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/outcome"}},
    "reason": {"type": "string", "minLength": 1, "maxLength": 512}
  },
  "$defs": {
    "directive": {
      "type": "object", "additionalProperties": false,
      "required": ["directive_id", "operation", "target", "value", "cause", "expected_effect", "scope", "expires_after_actions", "intervention_id"],
      "properties": {
        "directive_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "operation": {"enum": ["set_mode", "set_framework", "set_control", "prefer_statework"]},
        "target": {"type": "string", "minLength": 1, "maxLength": 128},
        "value": {"type": "string", "minLength": 1, "maxLength": 2048},
        "cause": {"type": "string", "minLength": 1, "maxLength": 128},
        "expected_effect": {"type": "string", "minLength": 1, "maxLength": 512},
        "scope": {"type": "string", "minLength": 1, "maxLength": 256},
        "expires_after_actions": {"type": "integer", "minimum": 1, "maximum": 64},
        "intervention_id": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    },
    "outcome": {
      "type": "object", "additionalProperties": false,
      "required": ["intervention_id", "cause", "outcome", "observed_revision", "evidence_refs"],
      "properties": {
        "intervention_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "cause": {"type": "string", "minLength": 1, "maxLength": 128},
        "outcome": {"enum": ["improved", "no_effect", "regressed", "expired", "withdrawn"]},
        "observed_revision": {"type": "integer", "minimum": 0},
        "evidence_refs": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}}
      }
    }
  }
}
