{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digitalpsychology.dev/schemas/behavioral-decision-v1.schema.json",
  "title": "DigitalPsychology BehavioralDecision v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["decision_id", "scope", "expected_revision", "state", "directives", "preferred_stateworks", "intervention_outcomes", "reason"],
  "properties": {
    "decision_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "scope": {"type": "string", "minLength": 1, "maxLength": 256},
    "expected_revision": {"type": "integer", "minimum": 0},
    "state": {"$ref": "behavior-state-v1.schema.json"},
    "directives": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/directive"}},
    "preferred_stateworks": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
    "intervention_outcomes": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/outcome"}},
    "reason": {"type": "string", "minLength": 1, "maxLength": 512}
  },
  "$defs": {
    "directive": {
      "type": "object", "additionalProperties": false,
      "required": ["directive_id", "operation", "target", "value", "cause", "expected_effect", "scope", "expires_after_actions", "intervention_id", "expires_at_action"],
      "properties": {
        "directive_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "operation": {"enum": ["set_mode", "set_framework", "set_control", "prefer_statework", "release_statework"]},
        "target": {"type": "string", "minLength": 1, "maxLength": 128},
        "value": {"type": "string", "minLength": 1, "maxLength": 2048},
        "cause": {"type": "string", "minLength": 1, "maxLength": 128},
        "expected_effect": {"type": "string", "minLength": 1, "maxLength": 512},
        "scope": {"type": "string", "minLength": 1, "maxLength": 256},
        "expires_after_actions": {"type": "integer", "minimum": 1, "maximum": 64},
        "intervention_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "expires_at_action": {"type": "integer", "minimum": 0}
      }
    },
    "outcome": {
      "type": "object", "additionalProperties": false,
      "required": ["intervention_id", "cause", "outcome", "observed_revision", "evidence_refs", "scope", "attribution", "criterion_ids_progressed", "goal_progress", "artifact_changed", "repeated_approach", "verification_quality", "comparison_id"],
      "properties": {
        "intervention_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "cause": {"type": "string", "minLength": 1, "maxLength": 128},
        "outcome": {"enum": ["effective", "ineffective", "regressed", "unattributed", "inconclusive", "expired", "withdrawn"]},
        "observed_revision": {"type": "integer", "minimum": 0},
        "evidence_refs": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
        "scope": {"type": "string", "minLength": 1, "maxLength": 256},
        "attribution": {"enum": ["supported", "confounded", "not_attributed", "none", "insufficient"]},
        "criterion_ids_progressed": {"type": "array", "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
        "goal_progress": {"type": ["boolean", "null"]},
        "artifact_changed": {"type": ["boolean", "null"]},
        "repeated_approach": {"type": ["boolean", "null"]},
        "verification_quality": {"enum": ["improved", "unchanged", "degraded", "unknown"]},
        "comparison_id": {"type": ["string", "null"], "maxLength": 128},
        "preventive_utility": {
          "type": "array", "maxItems": 4, "uniqueItems": true,
          "items": {"enum": [
            "prevented_invalid_completion", "caught_change_induced_regression",
            "detected_preexisting_regression", "prevented_unsafe_action"
          ]}
        },
        "target_criteria": {"type": "array", "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
        "task_set_outcome": {"oneOf": [{"type": "null"}, {"$ref": "behavior-state-v1.schema.json#/$defs/taskSetOutcome"}]}
      }
    }
  }
}
