{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digitalpsychology.dev/schemas/goal-set-snapshot-v2.schema.json",
  "title": "DigitalPsychology host-owned GoalSetSnapshot v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["revision", "items"],
  "properties": {
    "revision": {"type": "integer", "minimum": 0},
    "items": {
      "type": "array", "minItems": 1, "maxItems": 256,
      "items": {"$ref": "#/$defs/goalItem"}
    }
  },
  "$defs": {
    "goalItem": {
      "type": "object", "additionalProperties": false,
      "required": ["criterion_id", "required", "priority", "dependencies", "status",
                   "claim", "actions_since_progress", "equivalent_retry_count",
                   "last_progress_action", "material_progress_revision", "evidence_refs"],
      "properties": {
        "criterion_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "claim": {"type": "string", "maxLength": 512},
        "required": {"type": "boolean"},
        "priority": {"type": "integer", "minimum": 0, "maximum": 100},
        "dependencies": {
          "type": "array", "maxItems": 256, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 128}
        },
        "status": {"enum": ["READY", "ACTIVE", "VERIFIED", "BLOCKED",
                             "DEPENDENCY_BLOCKED", "DEFERRED_BY_OPERATOR"]},
        "actions_since_progress": {"type": "integer", "minimum": 0},
        "equivalent_retry_count": {"type": "integer", "minimum": 0},
        "last_progress_action": {"type": ["integer", "null"], "minimum": 0},
        "material_progress_revision": {"type": "integer", "minimum": 0},
        "evidence_refs": {
          "type": "array", "maxItems": 8, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 256}
        }
      }
    }
  }
}
