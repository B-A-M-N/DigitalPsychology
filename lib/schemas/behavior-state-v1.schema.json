{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digitalpsychology.dev/schemas/behavior-state-v1.schema.json",
  "title": "DigitalPsychology BehaviorState v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "revision", "cognitive_mode", "framework_modes", "active_stateworks",
    "focus_criteria", "verification_intensity", "exploration_budget",
    "retry_policy", "recovery_level", "context_strategy", "response_strategy",
    "active_interventions", "intervention_history"
  ],
  "properties": {
    "revision": {"type": "integer", "minimum": 0},
    "cognitive_mode": {"enum": ["DELIVER", "DIAGNOSE", "VERIFY", "RECOVER", "REPLAN", "BLOCKED", "REINSPECT", "READY_TO_COMPLETE"]},
    "framework_modes": {
      "type": "object", "maxProperties": 32,
      "propertyNames": {"type": "string", "minLength": 1, "maxLength": 64},
      "additionalProperties": {"enum": ["off", "passive", "normal", "elevated", "mandatory", "constrained", "reopen", "recovery", "reset"]},
      "properties": {"ward": {"const": "mandatory"}},
      "required": ["ward"]
    },
    "active_stateworks": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
    "focus_criteria": {"type": "array", "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
    "attention_lease": {
      "type": ["object", "null"], "additionalProperties": false,
      "required": ["lease_id", "criterion_ids", "issued_revision", "goal_set_revision", "start_action", "max_actions", "reason"],
      "properties": {
        "lease_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "criterion_ids": {"type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
        "issued_revision": {"type": "integer", "minimum": 0},
        "goal_set_revision": {"type": "integer", "minimum": 0},
        "start_action": {"type": "integer", "minimum": 0},
        "max_actions": {"type": "integer", "minimum": 1, "maximum": 8},
        "reason": {"type": "string", "minLength": 1, "maxLength": 128},
        "material_progress_revisions": {
          "type": "object", "maxProperties": 3,
          "propertyNames": {"type": "string", "minLength": 1, "maxLength": 128},
          "additionalProperties": {"type": "integer", "minimum": 0}
        },
        "continuous_attention_leases": {
          "type": "object", "maxProperties": 3,
          "propertyNames": {"type": "string", "minLength": 1, "maxLength": 128},
          "additionalProperties": {"type": "integer", "minimum": 0, "maximum": 2}
        }
      }
    },
    "mode_lease": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/modeLease"}
      ]
    },
    "attention_last_seen": {
      "type": "object", "maxProperties": 256,
      "propertyNames": {"type": "string", "minLength": 1, "maxLength": 128},
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "verification_intensity": {"enum": ["passive", "normal", "high", "strict"]},
    "exploration_budget": {"enum": ["disabled", "low", "normal", "bounded"]},
    "retry_policy": {"enum": ["normal", "materially_different_only", "no_retry"]},
    "recovery_level": {"type": "integer", "minimum": 0, "maximum": 3},
    "context_strategy": {"enum": ["standard", "compact", "criterion_focused"]},
    "response_strategy": {"enum": ["direct", "detailed", "structured"]},
    "active_interventions": {
      "type": "array", "maxItems": 16,
      "items": {"$ref": "#/$defs/intervention"}
    },
    "intervention_history": {
      "type": "array", "maxItems": 32,
      "items": {"$ref": "#/$defs/outcome"}
    }
  },
  "$defs": {
    "modeLease": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "entered_action", "minimum_actions", "max_actions",
                   "cause", "exit_condition", "baseline_approach_epoch"],
      "properties": {
        "mode": {"enum": ["DELIVER", "DIAGNOSE", "VERIFY", "RECOVER", "REPLAN", "BLOCKED", "REINSPECT", "READY_TO_COMPLETE"]},
        "entered_action": {"type": "integer", "minimum": 0},
        "minimum_actions": {"type": "integer", "minimum": 1, "maximum": 8},
        "max_actions": {"type": ["integer", "null"], "minimum": 1, "maximum": 32},
        "cause": {"type": "string", "minLength": 1, "maxLength": 128},
        "exit_condition": {"enum": ["minimum_duration", "progress_or_new_approach", "verification_result", "fresh_evidence", "plan_committed", "diagnostic_evidence"]},
        "baseline_approach_epoch": {"type": ["string", "null"], "maxLength": 256}
      }
    },
    "interventionTarget": {
      "type": "object", "additionalProperties": false,
      "required": ["target", "previous_value", "applied_value"],
      "properties": {
        "target": {"type": "string", "minLength": 1, "maxLength": 128},
        "previous_value": {"type": "string", "minLength": 1, "maxLength": 2048},
        "applied_value": {"type": "string", "minLength": 1, "maxLength": 2048}
      }
    },
    "intervention": {
      "type": "object", "additionalProperties": false,
      "required": ["intervention_id", "cause", "expected_effect", "start_revision", "scope", "expires_after_actions", "evaluation_horizon_actions", "actions_elapsed", "targets", "target_criteria", "baseline_criterion_status", "baseline_action_index", "concurrent_intervention_ids"],
      "properties": {
        "intervention_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "cause": {"type": "string", "minLength": 1, "maxLength": 128},
        "expected_effect": {"type": "string", "minLength": 1, "maxLength": 512},
        "start_revision": {"type": "integer", "minimum": 0},
        "scope": {"type": "string", "minLength": 1, "maxLength": 256},
        "expires_after_actions": {"type": "integer", "minimum": 1},
        "evaluation_horizon_actions": {"type": "integer", "minimum": 1, "maximum": 64},
        "actions_elapsed": {"type": "integer", "minimum": 0},
        "targets": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"$ref": "#/$defs/interventionTarget"}},
        "target_criteria": {"type": "array", "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
        "baseline_criterion_status": {
          "type": "object", "maxProperties": 8,
          "propertyNames": {"type": "string", "minLength": 1, "maxLength": 128},
          "additionalProperties": {"enum": ["unmet", "in_progress", "verified", "blocked", "unknown"]}
        },
        "baseline_action_index": {"type": "integer", "minimum": 0},
        "concurrent_intervention_ids": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
        "baseline_goal_set": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/goalSet"}]},
        "baseline_attention_last_seen": {
          "type": "object", "maxProperties": 256,
          "propertyNames": {"type": "string", "minLength": 1, "maxLength": 128},
          "additionalProperties": {"type": "integer", "minimum": 0}
        },
        "condition_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "condition_basis_digest": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    },
    "outcome": {
      "type": "object", "additionalProperties": false,
      "required": ["intervention_id", "cause", "outcome", "observed_revision", "evidence_refs", "scope", "attribution", "criterion_ids_progressed", "goal_progress", "artifact_changed", "repeated_approach", "verification_quality", "comparison_id"],
      "properties": {
        "intervention_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "cause": {"type": "string", "minLength": 1, "maxLength": 128},
        "outcome": {"enum": ["effective", "ineffective", "regressed", "unattributed", "inconclusive", "expired", "withdrawn"]},
        "observed_revision": {"type": "integer", "minimum": 0},
        "evidence_refs": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
        "scope": {"type": "string", "minLength": 1, "maxLength": 256},
        "attribution": {"enum": ["supported", "confounded", "not_attributed", "none", "insufficient"]},
        "criterion_ids_progressed": {"type": "array", "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
        "goal_progress": {"type": ["boolean", "null"]},
        "artifact_changed": {"type": ["boolean", "null"]},
        "repeated_approach": {"type": ["boolean", "null"]},
        "verification_quality": {"enum": ["improved", "unchanged", "degraded", "unknown"]},
        "comparison_id": {"type": ["string", "null"], "maxLength": 128},
        "target_criteria": {"type": "array", "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
        "task_set_outcome": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/taskSetOutcome"}]},
        "condition_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "condition_basis_digest": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    },
    "goalSet": {
      "type": "object", "additionalProperties": false,
      "required": ["revision", "items"],
      "properties": {
        "revision": {"type": "integer", "minimum": 0},
        "items": {
          "type": "array", "minItems": 1, "maxItems": 256,
          "items": {"$ref": "#/$defs/goalItem"}
        }
      }
    },
    "goalItem": {
      "type": "object", "additionalProperties": false,
      "required": ["criterion_id", "required", "priority", "dependencies", "status",
                   "actions_since_progress", "equivalent_retry_count", "last_progress_action"],
      "properties": {
        "criterion_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "required": {"type": "boolean"},
        "priority": {"type": "integer", "minimum": 0, "maximum": 100},
        "dependencies": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
        "status": {"enum": ["READY", "ACTIVE", "VERIFIED", "BLOCKED", "DEPENDENCY_BLOCKED", "DEFERRED_BY_OPERATOR"]},
        "actions_since_progress": {"type": "integer", "minimum": 0},
        "equivalent_retry_count": {"type": "integer", "minimum": 0},
        "last_progress_action": {"type": ["integer", "null"], "minimum": 0},
        "material_progress_revision": {"type": "integer", "minimum": 0}
      }
    },
    "taskSetOutcome": {
      "type": "object", "additionalProperties": false,
      "required": ["targeted_progress_delta", "total_required_remaining_before",
                   "total_required_remaining_after", "newly_verified", "newly_blocked",
                   "regressions", "max_starvation_before", "max_starvation_after",
                   "attention_coverage_delta"],
      "properties": {
        "targeted_progress_delta": {"type": "integer", "minimum": 0},
        "total_required_remaining_before": {"type": "integer", "minimum": 0},
        "total_required_remaining_after": {"type": "integer", "minimum": 0},
        "newly_verified": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
        "newly_blocked": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
        "regressions": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
        "max_starvation_before": {"type": "integer", "minimum": 0},
        "max_starvation_after": {"type": "integer", "minimum": 0},
        "attention_coverage_delta": {"type": "integer"}
      }
    }
  }
}
