{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digitalpsychology.dev/schemas/behavior-state-v1.schema.json",
  "title": "DigitalPsychology BehaviorState v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "revision", "cognitive_mode", "framework_modes", "active_stateworks",
    "focus_criteria", "verification_intensity", "exploration_budget",
    "retry_policy", "recovery_level", "context_strategy", "response_strategy",
    "active_interventions", "intervention_history"
  ],
  "properties": {
    "revision": {"type": "integer", "minimum": 0},
    "cognitive_mode": {"enum": ["DELIVER", "DIAGNOSE", "VERIFY", "RECOVER", "REPLAN", "BLOCKED", "REINSPECT", "READY_TO_COMPLETE"]},
    "framework_modes": {
      "type": "object", "maxProperties": 32,
      "propertyNames": {"type": "string", "minLength": 1, "maxLength": 64},
      "additionalProperties": {"enum": ["off", "passive", "normal", "elevated", "mandatory", "constrained", "reopen", "recovery", "reset"]},
      "properties": {"ward": {"const": "mandatory"}},
      "required": ["ward"]
    },
    "active_stateworks": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
    "focus_criteria": {"type": "array", "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
    "verification_intensity": {"enum": ["passive", "normal", "high", "strict"]},
    "exploration_budget": {"enum": ["disabled", "low", "normal", "bounded"]},
    "retry_policy": {"enum": ["normal", "materially_different_only", "no_retry"]},
    "recovery_level": {"type": "integer", "minimum": 0, "maximum": 3},
    "context_strategy": {"enum": ["standard", "compact", "criterion_focused"]},
    "response_strategy": {"enum": ["direct", "detailed", "structured"]},
    "active_interventions": {
      "type": "array", "maxItems": 16,
      "items": {"$ref": "#/$defs/intervention"}
    },
    "intervention_history": {
      "type": "array", "maxItems": 32,
      "items": {"$ref": "#/$defs/outcome"}
    }
  },
  "$defs": {
    "interventionTarget": {
      "type": "object", "additionalProperties": false,
      "required": ["target", "previous_value", "applied_value"],
      "properties": {
        "target": {"type": "string", "minLength": 1, "maxLength": 128},
        "previous_value": {"type": "string", "minLength": 1, "maxLength": 2048},
        "applied_value": {"type": "string", "minLength": 1, "maxLength": 2048}
      }
    },
    "intervention": {
      "type": "object", "additionalProperties": false,
      "required": ["intervention_id", "cause", "expected_effect", "start_revision", "scope", "expires_after_actions", "evaluation_horizon_actions", "actions_elapsed", "targets", "target_criteria", "baseline_criterion_status", "baseline_action_index", "concurrent_intervention_ids"],
      "properties": {
        "intervention_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "cause": {"type": "string", "minLength": 1, "maxLength": 128},
        "expected_effect": {"type": "string", "minLength": 1, "maxLength": 512},
        "start_revision": {"type": "integer", "minimum": 0},
        "scope": {"type": "string", "minLength": 1, "maxLength": 256},
        "expires_after_actions": {"type": "integer", "minimum": 1},
        "evaluation_horizon_actions": {"type": "integer", "minimum": 1, "maximum": 64},
        "actions_elapsed": {"type": "integer", "minimum": 0},
        "targets": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"$ref": "#/$defs/interventionTarget"}},
        "target_criteria": {"type": "array", "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
        "baseline_criterion_status": {
          "type": "object", "maxProperties": 8,
          "propertyNames": {"type": "string", "minLength": 1, "maxLength": 128},
          "additionalProperties": {"enum": ["unmet", "in_progress", "verified", "blocked", "unknown"]}
        },
        "baseline_action_index": {"type": "integer", "minimum": 0},
        "concurrent_intervention_ids": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}}
      }
    },
    "outcome": {
      "type": "object", "additionalProperties": false,
      "required": ["intervention_id", "cause", "outcome", "observed_revision", "evidence_refs", "scope", "attribution", "criterion_ids_progressed", "goal_progress", "artifact_changed", "repeated_approach", "verification_quality", "comparison_id"],
      "properties": {
        "intervention_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "cause": {"type": "string", "minLength": 1, "maxLength": 128},
        "outcome": {"enum": ["effective", "ineffective", "regressed", "unattributed", "inconclusive", "expired", "withdrawn"]},
        "observed_revision": {"type": "integer", "minimum": 0},
        "evidence_refs": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
        "scope": {"type": "string", "minLength": 1, "maxLength": 256},
        "attribution": {"enum": ["supported", "confounded", "not_attributed", "none", "insufficient"]},
        "criterion_ids_progressed": {"type": "array", "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
        "goal_progress": {"type": ["boolean", "null"]},
        "artifact_changed": {"type": ["boolean", "null"]},
        "repeated_approach": {"type": ["boolean", "null"]},
        "verification_quality": {"enum": ["improved", "unchanged", "degraded", "unknown"]},
        "comparison_id": {"type": ["string", "null"], "maxLength": 128}
      }
    }
  }
}
